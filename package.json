{
  "name": "lasercut-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop editor for parametric laser-cut designs",
  "homepage": "https://github.com/mastercad/lasercut-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastercad/lasercut-studio.git"
  },
  "bugs": {
    "url": "https://github.com/mastercad/lasercut-studio/issues"
  },
  "author": {
    "name": "LaserCut Studio Contributors",
    "email": "maintainers@example.invalid"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && electron-builder --publish never",
    "build:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "build:windows": "npm run build && electron-builder --win portable nsis --publish never",
    "build:macos": "npm run build && electron-builder --mac zip dmg --publish never",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "build": {
    "appId": "de.lasercutstudio.editor",
    "productName": "LaserCut Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "jszip": "3.10.1",
    "lucide-react": "^0.468.0",
    "opentype.js": "^2.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1",
    "three-bvh-csg": "0.0.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  }
}
